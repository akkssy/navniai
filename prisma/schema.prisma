// NavniAI - Prisma Schema
// User management, workflows, and settings

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (NextAuth compatible) ───

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  workflows   Workflow[]
  llmSettings LLMSettings?
  customAgents CustomAgent[]
  documents   Document[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── App Models ───

model Workflow {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("draft")
  config    String   @default("{}") // JSON string of workflow nodes/edges
  runs      Int      @default(0)
  lastRunAt DateTime?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowRuns WorkflowRun[]
}

model WorkflowRun {
  id            String   @id @default(cuid())
  workflowId    String?
  userId        String?
  pipelineType  String   @default("custom") // "custom" | "content" | template id
  name          String   @default("Untitled Run")
  status        String   @default("running") // "running" | "completed" | "failed"
  briefJson     String?  // JSON of ContentBrief or custom inputs
  executionTime Float?   // seconds
  stepsTotal    Int      @default(0)
  stepsCompleted Int     @default(0)
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  workflow    Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  stepResults StepResult[]

  @@index([userId])
  @@index([pipelineType])
}

model StepResult {
  id              String   @id @default(cuid())
  workflowRunId   String
  stepId          String   // node id from the execution
  agentId         String   // e.g. "researcher", "writer", "generator"
  agentName       String   @default("")
  action          String   @default("execute")
  status          String   @default("completed") // "completed" | "failed"
  output          String   // the LLM output text
  provider        String   @default("simulated") // which LLM provider was used
  structuredJson  String?  // JSON string of parsed structured output (AgentStructuredOutput)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
}

model LLMSettings {
  id             String @id @default(cuid())
  userId         String @unique
  activeProvider String @default("ollama")
  fallbackChain  String @default("ollama,groq,openai,openrouter") // comma-separated
  providersJson  String @default("{}") // JSON of provider configs
  brandVoice     String @default("") // User's brand voice / persona injected into every agent

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomAgent {
  id           String @id @default(cuid())
  userId       String
  name         String
  type         String
  icon         String @default("🤖")
  systemPrompt String @default("")
  config       String @default("{}") // JSON
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── RAG / Knowledge Base Models ───

model Document {
  id        String   @id @default(cuid())
  userId    String
  name      String           // "employee_handbook.pdf"
  type      String           // "pdf", "csv", "md", "txt"
  size      Int              // file size in bytes
  tags      String   @default("[]")  // JSON array for filtering
  chunkCount Int     @default(0)
  createdAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@index([userId])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String           // the text chunk
  embedding  Unsupported("vector(768)")  // pgvector — 768-dim (EmbeddingGemma compatible)
  metadata   String   @default("{}")  // page number, section, etc.
  chunkIndex Int

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}


// ─── Agent Memory (cross-run scratchpad persistence) ───

model AgentMemory {
  id           String   @id @default(cuid())
  userId       String?
  workflowName String
  key          String
  value        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, workflowName, key])
  @@index([userId, workflowName])
}
